# Compiled binaries. They get built from source or downloaded from Releases.
/glasshouse
/dist/
/glasshouse.exe
*.exe
/dist/

# Editor and system leftovers
.vscode/
.idea/
.DS_Store
Thumbs.db

# A saved report is a description of somebody's machine. Keeping one out of
# the repository by accident is exactly the mistake this tool exists to
# help people avoid.
*.report
*.report.txt

# Test binaries built into the tree, because Application Control on some
# Windows machines blocks running them from the temp directory.
/gh-linux
/gh-test-linux
/glasshouse-test.exe
